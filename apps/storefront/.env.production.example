# ====================================================================
# VARIABLES DE ENTORNO PARA PRODUCCIÓN - STOREFRONT EN VERCEL
# (Pégalas en: Vercel Dashboard -> Project -> Settings -> Environment Variables)
# ====================================================================

# 1. URL de tu Backend Medusa desplegado en producción
NEXT_PUBLIC_MEDUSA_BACKEND_URL="https://backend-production-xyz.up.railway.app"

# 2. Clave Publicable de Medusa (Obtenida del panel admin o de .env.local)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY="pk_89ef881f192f2ba8c6b88c5ddd7c1375f3e75cdb8d19022573cb47acff358187"

# 3. Región por defecto (Colombia: co en Pesos COP)
NEXT_PUBLIC_DEFAULT_REGION="co"

# 4. URL Pública de tu Tienda en Vercel
NEXT_PUBLIC_BASE_URL="https://mi-tienda-super-express.vercel.app"

# 5. Entorno
NODE_ENV="production"
