# ====================================================================
# VARIABLES DE ENTORNO PARA PRODUCCIÓN - MEDUSA BACKEND (SUPABASE)
# ====================================================================

# 1. Conexión a Base de Datos PostgreSQL en Supabase
# Obtén esta URL en Supabase: Project Settings -> Database -> Connection string (URI)
# IMPORTANTE: Usa el Transaction Pooler (puerto 6543) o conexión directa (puerto 5432) con sslmode=require
DATABASE_URL="postgres://postgres.[TU-PROYECTO-ID]:[TU-PASSWORD]@aws-0-[TU-REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# 2. CORS de la Tienda (URL de tu tienda en Vercel)
STORE_CORS="https://mi-tienda-super-express.vercel.app,http://localhost:8000"

# 3. CORS del Panel de Administración
ADMIN_CORS="https://mi-tienda-super-express.vercel.app,https://backend-production-xyz.up.railway.app,http://localhost:9000,http://localhost:5173"

# 4. CORS de Autenticación
AUTH_CORS="https://mi-tienda-super-express.vercel.app,https://backend-production-xyz.up.railway.app,http://localhost:8000,http://localhost:9000"

# 5. Claves Secretas de Producción (Genera cadenas seguras aleatorias)
JWT_SECRET="supersecret_jwt_cambiar_en_produccion_123456789"
COOKIE_SECRET="supersecret_cookie_cambiar_en_produccion_123456789"

# 6. Modo de Entorno
NODE_ENV="production"
PORT=9000
